#!/usr/bin/env python3
# qr-kdeconnect - the phone side of a quick reply.
#
#   qr-kdeconnect list                every repliable phone notification, as JSON
#   qr-kdeconnect reply PATH          send a reply -- TEXT is read from stdin
#   qr-kdeconnect dismiss PATH        clear the notification on the phone
#
# KDE Connect mirrors phone notifications onto the desktop bus like any other
# app, and that is all the freedesktop notification spec can carry. It also
# keeps one object per notification on ITS OWN bus with the part the spec has
# no room for: a replyId, and a sendReply method that puts text back into the
# conversation on the phone.
#
# This helper only ever reports what is there. Which apps are allowed to reach
# the bar is decided in the widget (the `apps` whitelist), not here - so the
# policy lives in one place you can see, and changing it needs no restart.
#
# `list` output: JSON array of
#   { path, notificationsPath, deviceId, replyId, appName, title, ticker,
#     text, body, dismissable, icon }
# replyId is always non-empty here; entries without one are dropped. `icon` is
# the local PNG KDE Connect wrote for the notification (usually the sender's
# avatar for a chat app), or "" when there is none.
#
# Argv discipline: the reply text is private message content and NEVER appears
# as an argv element -- argv is world-readable through /proc/<pid>/cmdline. It
# is read from stdin (bounded), and `reply` / `dismiss` make their D-Bus calls
# in-process via GDBus (python-gobject), so the text is not an argument of any
# subprocess either. Only `list` still shells out to `busctl`, and its argv
# carries nothing but object paths and interface names.

import json
import os
import subprocess
import sys

BUS = "org.kde.kdeconnect"
IFACE_NOTE = "org.kde.kdeconnect.device.notifications.notification"
IFACE_PARENT = "org.kde.kdeconnect.device.notifications"

# Largest reply we will read off stdin. KDE Connect replies are short; this is
# only a guard against an unbounded read.
MAX_REPLY_BYTES = 64 * 1024


def dbus_call(object_path, iface, method, signature, args, timeout_ms=8000):
    """Call a session-bus method in-process (no subprocess, no argv).
    Returns (ok: bool, error: str)."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except Exception as exc:
        return False, "python-gobject (gi) is required for D-Bus calls: %s" % exc
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        params = GLib.Variant(signature, tuple(args)) if signature else None
        bus.call_sync(BUS, object_path, iface, method, params, None,
                      Gio.DBusCallFlags.NONE, timeout_ms, None)
        return True, ""
    except Exception as exc:
        return False, str(exc)


def run(args, timeout=8):
    try:
        return subprocess.run(
            args, capture_output=True, text=True, check=False, timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None


def leaf_paths():
    """Every .../notifications/<n> object across all paired devices."""
    res = run(["busctl", "--user", "tree", BUS, "--list", "--no-pager"])
    if res is None or res.returncode not in (0, 1):
        return []
    out = []
    for line in res.stdout.splitlines():
        p = line.strip()
        parts = p.split("/")
        # /modules/kdeconnect/devices/<dev>/notifications/<leaf>
        if (
            len(parts) == 7
            and parts[1] == "modules"
            and parts[2] == "kdeconnect"
            and parts[3] == "devices"
            and parts[5] == "notifications"
            and parts[6]
        ):
            out.append(p)
    return out


def properties(path):
    res = run(
        [
            "busctl", "--user", "--json=short", "call", BUS, path,
            "org.freedesktop.DBus.Properties", "GetAll", "s", IFACE_NOTE,
        ]
    )
    if res is None or res.returncode != 0:
        return None
    try:
        data = json.loads(res.stdout)["data"][0]
    except (ValueError, KeyError, IndexError):
        return None
    return {k: v.get("data") for k, v in data.items()}


def listing():
    out = []
    for path in leaf_paths():
        props = properties(path)
        if not props:
            continue
        reply_id = str(props.get("replyId") or "")
        if not reply_id:
            continue  # not something you can answer
        title = str(props.get("title") or "")
        ticker = str(props.get("ticker") or "")
        body = ticker
        if title and ticker.startswith(title + ": "):
            body = ticker[len(title) + 2:]
        notifications_path = path.rsplit("/", 1)[0]
        device_id = path.split("/")[4]
        icon = ""
        if props.get("hasIcon"):
            ip = str(props.get("iconPath") or "")
            if ip and os.path.isfile(ip):
                icon = ip
        out.append(
            {
                "path": path,
                "notificationsPath": notifications_path,
                "deviceId": device_id,
                "replyId": reply_id,
                "appName": str(props.get("appName") or ""),
                "title": title,
                "ticker": ticker,
                "text": str(props.get("text") or ""),
                "body": body,
                "dismissable": bool(props.get("dismissable")),
                "icon": icon,
            }
        )
    return out


def main():
    if len(sys.argv) < 2:
        return 2
    verb = sys.argv[1]

    if verb == "list":
        json.dump(listing(), sys.stdout, separators=(",", ":"))
        return 0

    if verb == "reply":
        if len(sys.argv) < 3:
            return 2
        path = sys.argv[2]
        # Text on stdin, never argv. Bounded read; EOF (the caller closing the
        # pipe) ends it.
        text = sys.stdin.buffer.read(MAX_REPLY_BYTES).decode("utf-8", "replace")
        if text.endswith("\n"):
            text = text[:-1]
        if not text.strip():
            return 1
        props = properties(path) or {}
        reply_id = str(props.get("replyId") or "")
        if not reply_id:
            sys.stderr.write("no replyId on " + path)
            return 1
        notifications_path = path.rsplit("/", 1)[0]
        ok, err = dbus_call(notifications_path, IFACE_PARENT, "sendReply",
                            "(ss)", (reply_id, text))
        if not ok:
            sys.stderr.write("sendReply failed: " + err)
            return 1
        sys.stdout.write("sent")
        return 0

    if verb == "dismiss":
        if len(sys.argv) < 3:
            return 2
        path = sys.argv[2]
        ok, err = dbus_call(path, IFACE_NOTE, "dismiss", "", ())
        if not ok:
            sys.stderr.write("dismiss failed: " + err)
            return 1
        sys.stdout.write("dismissed")
        return 0

    return 2


if __name__ == "__main__":
    sys.exit(main())
